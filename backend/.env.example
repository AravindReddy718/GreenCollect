# Janatha Garage (GreenCollect) Backend Environment Configuration
PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/janathagarage?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Password reset emails (optional in development)
# Without these, the reset link is printed in the backend terminal instead of being emailed.
# Works with any SMTP provider, e.g. Gmail (smtp.gmail.com, port 587), Brevo, SendGrid.
# Gmail: use your real address and a 16-character App Password (needs 2-Step Verification);
# your normal Gmail password is rejected with "535 Username and Password not accepted".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Janatha Garage <no-reply@example.com>"
